---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Contact | Let's Solve Your People Problems — New Leaf Analytics"
  description="Schedule a consultation with Ian Blad. Diagnose your workforce turnover, automate evaluation reporting, or build scalable HR data pipelines."
>
  <div class="py-16 sm:py-24 lg:py-32">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      
      <!-- HEADER -->
      <div class="max-w-3xl mb-16 sm:mb-20">
        <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 border border-emerald-200/80 px-4 py-1.5 text-xs sm:text-sm font-bold uppercase tracking-widest text-emerald-800 shadow-sm mb-6">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          Direct Consultation
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-950 font-sans leading-tight">
          Let's Solve Your People Problems
        </h1>
        <p class="mt-6 text-xl sm:text-2xl text-slate-600 font-normal leading-relaxed">
          Whether you need a full turnover diagnostic or a foundational data pipeline, reach out to schedule a focused discovery session.
        </p>
      </div>

      <!-- CONTACT CARDS GRID -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16 sm:mb-24">
        
        <!-- Email Card -->
        <div class="rounded-3xl border border-white/70 bg-white/55 p-8 sm:p-10 backdrop-blur-2xl shadow-[0_8px_30px_rgba(0,0,0,0.03),inset_0_1px_1px_rgba(255,255,255,0.9)] hover:border-emerald-400/50 hover:bg-white/70 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 mb-6 font-mono font-bold text-base shadow-sm">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-500 font-mono">Email</div>
            <h3 class="text-xl font-bold text-slate-950 mt-1 font-sans">Direct Inbox</h3>
            <p class="mt-3 text-base text-slate-600">Typically replies within 24 business hours.</p>
          </div>
          <div class="mt-8 pt-6 border-t border-white/80">
            <a
              href="mailto:ian@newleaf-analytics.com"
              class="inline-flex items-center gap-1.5 text-base font-bold text-emerald-700 hover:text-emerald-800 break-all"
            >
              ian@newleaf-analytics.com →
            </a>
          </div>
        </div>

        <!-- Phone Card -->
        <div class="rounded-3xl border border-white/70 bg-white/55 p-8 sm:p-10 backdrop-blur-2xl shadow-[0_8px_30px_rgba(0,0,0,0.03),inset_0_1px_1px_rgba(255,255,255,0.9)] hover:border-emerald-400/50 hover:bg-white/70 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 mb-6 font-mono font-bold text-base shadow-sm">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-500 font-mono">Phone</div>
            <h3 class="text-xl font-bold text-slate-950 mt-1 font-sans">Voice & Text</h3>
            <p class="mt-3 text-base text-slate-600">Available Monday–Friday, 9am–5pm PT.</p>
          </div>
          <div class="mt-8 pt-6 border-t border-white/80">
            <a
              href="tel:4698738496"
              class="inline-flex items-center gap-1.5 text-base font-bold text-emerald-700 hover:text-emerald-800"
            >
              (469) 873-8496 →
            </a>
          </div>
        </div>

        <!-- LinkedIn Card -->
        <div class="rounded-3xl border border-white/70 bg-white/55 p-8 sm:p-10 backdrop-blur-2xl shadow-[0_8px_30px_rgba(0,0,0,0.03),inset_0_1px_1px_rgba(255,255,255,0.9)] hover:border-emerald-400/50 hover:bg-white/70 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 mb-6 font-mono font-bold text-base shadow-sm">
              <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
            </div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-500 font-mono">LinkedIn</div>
            <h3 class="text-xl font-bold text-slate-950 mt-1 font-sans">Professional Network</h3>
            <p class="mt-3 text-base text-slate-600">Connect and message directly on LinkedIn.</p>
          </div>
          <div class="mt-8 pt-6 border-t border-white/80">
            <a
              href="https://www.linkedin.com/in/ianblad"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-base font-bold text-emerald-700 hover:text-emerald-800"
            >
              Connect with me on LinkedIn →
            </a>
          </div>
        </div>

      </div>

      <!-- DISCOVERY SESSION EXPECTATION CARD -->
      <div class="rounded-3xl border border-white/70 bg-white/60 p-8 sm:p-12 backdrop-blur-2xl shadow-[0_12px_40px_rgba(0,0,0,0.04),inset_0_1px_1px_rgba(255,255,255,0.95)]">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-950 font-sans tracking-tight mb-4">
          What happens during a discovery session?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
          <div>
            <div class="text-emerald-700 font-mono font-bold text-sm mb-2">STEP 01</div>
            <h3 class="text-lg font-bold text-slate-950">System Assessment</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              We examine your current HR tech stack (ATS, Payroll, review cadence, and spreadsheets) to identify friction points and manual bottlenecks.
            </p>
          </div>
          <div>
            <div class="text-emerald-700 font-mono font-bold text-sm mb-2">STEP 02</div>
            <h3 class="text-lg font-bold text-slate-950">Turnover Diagnostic</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              We discuss historical turnover patterns and review what data points you currently capture (or should be capturing) to anticipate flight risks.
            </p>
          </div>
          <div>
            <div class="text-emerald-700 font-mono font-bold text-sm mb-2">STEP 03</div>
            <h3 class="text-lg font-bold text-slate-950">Concrete Architecture Plan</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              You receive an actionable blueprint for automated pipelines, evaluation workflows, and expected time and cost savings.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>

