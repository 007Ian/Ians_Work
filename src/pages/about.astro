---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ioBooks = [
  { title: '7 Habits of Highly Effective People', author: 'Stephen Covey' },
  { title: 'The Best Place to Work', author: 'Ron Friedman' },
  { title: 'The Culture Code', author: 'Daniel Coyle' },
  { title: 'Drive', author: 'Daniel Pink' },
  { title: "Locke and Latham's Goal Setting Theory & Associated Papers", author: 'Edwin Locke & Gary Latham' },
  { title: 'Five Dysfunctions of a Team', author: 'Patrick Lencioni' },
  { title: 'Crossing the Unknown Sea', author: 'David Whyte' },
];

const psychBooks = [
  { title: 'Thinking, Fast and Slow', author: 'Daniel Kahneman' },
  { title: 'Noise: A Flaw in Human Judgment', author: 'Daniel Kahneman, Olivier Sibony, & Cass Sunstein' },
  { title: 'The Memory Illusion', author: 'Elizabeth Loftus' },
  { title: 'False Positives in Psychology', author: 'Uri Simonsohn, Leif Nelson, & Joseph Simmons' },
  { title: 'Maps of Meaning', author: 'Jordan Peterson' },
  { title: 'The Sacred and the Profane', author: 'Mircea Eliade' },
  { title: '12 Rules for Life', author: 'Jordan Peterson' },
];

const philosophyPapers = [
  { title: 'Famine, Affluence, and Morality', author: 'Peter Singer' },
  { title: 'Argument from Queerness', author: 'J.L. Mackie' },
  { title: 'What is Weird about Moral Deference', author: 'Sarah McGrath' },
  { title: 'Evil and Omnipotence', author: 'J.L. Mackie' },
  { title: 'The Free Will Defense', author: 'Alvin Plantinga' },
  { title: 'Soul Making Theodicy', author: 'John Hick' },
  { title: "Horrendous Evils and God's Goodness", author: 'Marilyn McCord Adams' },
];
---

<Layout
  title="About Ian Blad | New Leaf Analytics"
  description="Bridging the gap between Human Resources and Advanced Analytics. Learn about Ian Blad's background, research focus, and foundational intellectual influences."
>
  <div class="py-16 sm:py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- HEADER -->
      <div class="max-w-3xl mb-16 sm:mb-24">
        <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 border border-emerald-200/80 px-4 py-1.5 text-xs sm:text-sm font-bold uppercase tracking-widest text-emerald-800 shadow-sm mb-6">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          Principal Bio
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-950 font-sans leading-tight">
          About Me
        </h1>
        <p class="mt-6 text-xl sm:text-2xl text-slate-600 font-normal leading-relaxed">
          Bridging the gap between Human Resources and Advanced Analytics.
        </p>
      </div>

      <!-- MAIN BIO HERO CARD -->
      <div class="rounded-3xl border border-white/70 bg-white/60 p-6 sm:p-12 lg:p-16 backdrop-blur-2xl shadow-[0_12px_40px_rgba(0,0,0,0.04),inset_0_1px_1px_rgba(255,255,255,0.95)] mb-20 sm:mb-28">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-5 flex justify-center">
            <div class="relative group">
              <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-emerald-500 to-teal-400 opacity-25 blur-2xl group-hover:opacity-35 transition-opacity"></div>
              <img
                src={`${base}/images/ian-blad-headshot.jpg`}
                alt="Ian Blad — Principal Consultant"
                class="relative h-64 w-64 sm:h-80 sm:w-80 lg:h-96 lg:w-96 max-w-full aspect-square rounded-3xl object-cover shadow-2xl border-4 border-white/90"
              />
            </div>
          </div>

          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-widest text-emerald-700 font-mono">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              Transforming The Workplace through Data-Driven Solutions
            </div>
            
            <p class="text-lg sm:text-xl text-slate-800 leading-relaxed font-normal">
              Ever since I read the book <em>7 Habits of Highly Effective People</em> in high school, I have been fascinated by how our ideas and perceptions about the world can actively influence the way we experience it.
            </p>
            <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
              I believe it is essential to be a well-read person in order to be a creative and empathetic problem solver. In organizational analytics, mathematical models are only as good as the psychological theory underlying them. By marrying rigorous statistics (R, Python, SQL, predictive logistics) with deep empathy for human motivation, we produce workforce systems that endure.
            </p>

            <div class="pt-4 flex flex-wrap items-center gap-4 text-sm font-semibold">
              <a
                href={`${base}/resume`}
                class="inline-flex items-center gap-1.5 text-emerald-700 hover:text-emerald-800"
              >
                View Full Curriculum Vitae →
              </a>
              <span class="text-slate-300">|</span>
              <a
                href={`${base}/contact`}
                class="inline-flex items-center gap-1.5 text-slate-700 hover:text-slate-950"
              >
                Schedule Consultation →
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- INFLUENTIAL LITERATURE SECTION -->
      <section class="mb-24 sm:mb-32">
        <div class="max-w-3xl mb-12">
          <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 border border-emerald-200/80 px-3.5 py-1 text-xs font-bold uppercase tracking-widest text-emerald-800 shadow-sm mb-4">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Intellectual Foundations
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-950 font-sans">
            Books & Papers Influencing My Work
          </h2>
          <p class="mt-3 text-base sm:text-lg text-slate-600 leading-relaxed">
            Here are some of the texts that have had the biggest influence on my thinking, diagnostic methodology, and approach to organizational health:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <!-- Category 1: I/O Psychology -->
          <div class="rounded-3xl border border-white/70 bg-white/55 p-8 sm:p-10 backdrop-blur-2xl shadow-[0_8px_30px_rgba(0,0,0,0.03),inset_0_1px_1px_rgba(255,255,255,0.9)] flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-700 font-mono mb-6 pb-4 border-b border-white/80">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                I/O Psychology
              </div>
              <ul class="space-y-5">
                {ioBooks.map((item) => (
                  <li class="group">
                    <div class="text-base font-bold text-slate-900 group-hover:text-emerald-700 transition-colors">
                      {item.title}
                    </div>
                    <div class="text-xs text-slate-500 mt-0.5">by {item.author}</div>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Category 2: Psychology -->
          <div class="rounded-3xl border border-white/70 bg-white/55 p-8 sm:p-10 backdrop-blur-2xl shadow-[0_8px_30px_rgba(0,0,0,0.03),inset_0_1px_1px_rgba(255,255,255,0.9)] flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-700 font-mono mb-6 pb-4 border-b border-white/80">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                Psychology & Decision Science
              </div>
              <ul class="space-y-5">
                {psychBooks.map((item) => (
                  <li class="group">
                    <div class="text-base font-bold text-slate-900 group-hover:text-emerald-700 transition-colors">
                      {item.title}
                    </div>
                    <div class="text-xs text-slate-500 mt-0.5">by {item.author}</div>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Category 3: Philosophy -->
          <div class="rounded-3xl border border-white/70 bg-white/55 p-8 sm:p-10 backdrop-blur-2xl shadow-[0_8px_30px_rgba(0,0,0,0.03),inset_0_1px_1px_rgba(255,255,255,0.9)] flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-700 font-mono mb-6 pb-4 border-b border-white/80">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                Philosophy & Ethics
              </div>
              <ul class="space-y-5">
                {philosophyPapers.map((item) => (
                  <li class="group">
                    <div class="text-base font-bold text-slate-900 group-hover:text-emerald-700 transition-colors">
                      {item.title}
                    </div>
                    <div class="text-xs text-slate-500 mt-0.5">by {item.author}</div>
                  </li>
                ))}
              </ul>
            </div>
          </div>

        </div>
      </section>

      <!-- NAVIGATION LINKS FOOTER -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6 rounded-3xl border border-white/70 bg-white/60 p-8 sm:p-10 backdrop-blur-2xl shadow-sm">
        <div>
          <h3 class="text-xl font-bold text-slate-950 font-sans">Explore Ian's Research & Engagements</h3>
          <p class="text-sm text-slate-600 mt-1">Review statistical case studies or initiate a consultation.</p>
        </div>
        <div class="flex items-center gap-4 shrink-0">
          <a
            href={`${base}/projects`}
            class="inline-flex items-center rounded-2xl border border-white/80 bg-white/80 px-6 py-3 text-sm font-semibold text-slate-900 shadow-sm hover:border-emerald-400 hover:text-emerald-700 transition-colors"
          >
            View Projects
          </a>
          <a
            href={`${base}/contact`}
            class="inline-flex items-center rounded-2xl bg-gradient-to-r from-emerald-600 to-brand-500 px-6 py-3 text-sm font-semibold text-white shadow-glow transition-all hover:from-emerald-500 hover:to-brand-400"
          >
            Let's Work Together
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>

