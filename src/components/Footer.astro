---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-200/80 bg-white text-ink-700">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-zinc-100">
      <!-- Col 1: Brand & Bio -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 shadow-glow-sm">
            <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
            </svg>
          </div>
          <span class="text-base font-bold tracking-tight text-ink-950 font-sans">New Leaf Analytics</span>
        </div>
      </div>

      <!-- Col 2: Capabilities -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink-950">Capabilities</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`${base}/services`} class="text-ink-500 hover:text-brand-600 transition-colors">
              Predictive Turnover Modeling
            </a>
          </li>
          <li>
            <a href={`${base}/services`} class="text-ink-500 hover:text-brand-600 transition-colors">
              Automated Evaluation Systems
            </a>
          </li>
          <li>
            <a href={`${base}/services`} class="text-ink-500 hover:text-brand-600 transition-colors">
              BigQuery Data Warehousing
            </a>
          </li>
          <li>
            <a href={`${base}/services`} class="text-ink-500 hover:text-brand-600 transition-colors">
              Structured Interview Systems
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Direct Connect -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink-950">Connect</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="mailto:ian@newleaf-analytics.com" class="text-ink-500 hover:text-brand-600 transition-colors flex items-center gap-2">
              <svg class="h-4 w-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              ian@newleaf-analytics.com
            </a>
          </li>
          <li>
            <a href="tel:4698738496" class="text-ink-500 hover:text-brand-600 transition-colors flex items-center gap-2">
              <svg class="h-4 w-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              (469) 873-8496
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/ianblad" target="_blank" rel="noopener noreferrer" class="text-ink-500 hover:text-brand-600 transition-colors flex items-center gap-2">
              <svg class="h-4 w-4 text-brand-600 fill-current" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
              LinkedIn Profile
            </a>
          </li>
          <li>
            <a href="https://github.com/007Ian" target="_blank" rel="noopener noreferrer" class="text-ink-500 hover:text-brand-600 transition-colors flex items-center gap-2">
              <svg class="h-4 w-4 text-brand-600 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              GitHub Portfolio
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between pt-6 text-xs text-ink-500 gap-4">
      <p>© {currentYear} Ian Blad. All rights reserved. Built with pure semantic HTML & Tailwind CSS.</p>
      <div class="flex items-center gap-4">
        <span>Seattle, WA & Rexburg, ID</span>
        <span>•</span>
        <a href={`${base}/resume`} class="hover:underline">Credentials</a>
        <span>•</span>
        <a href={`${base}/contact`} class="hover:underline">Schedule Call</a>
      </div>
    </div>
  </div>
</footer>

